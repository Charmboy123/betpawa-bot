APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
PAPER_MODE=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/betpawa_bot

BETPAWA_BASE_URL=
BETPAWA_API_KEY=
BETPAWA_API_SECRET=
BETPAWA_TIMEOUT_CONNECT=5.0
BETPAWA_TIMEOUT_READ=15.0
BETPAWA_RATE_LIMIT_PER_MIN=30

MIN_MODEL_PROBABILITY=0.55
MIN_EDGE=0.03
MIN_EXPECTED_VALUE=0.02
MIN_MODEL_AGREEMENT=0.60
MAX_DAILY_EXPOSURE_PCT=0.10
MAX_STAKE_PCT=0.02
DEFAULT_BANKROLL=100000
MONTE_CARLO_SIMULATIONS=10000
SCHEDULER_INTERVAL_MINUTES=15
ODDS_CHANGE_TOLERANCE_PCT=0.03

DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
